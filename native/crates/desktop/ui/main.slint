import { Button, Slider, ScrollView, ListView, AboutSlint, ComboBox, LineEdit } from "std-widgets.slint";

export struct PhotoView {
    name: string,
    detail: string,
    stars: string,
    thumbnail: image,
}

component ToolButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> active: true;
    callback triggered();
    height: 34px;
    min-width: 72px;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: !root.active ? #20242a : root.primary ? #e6bd65 : pointer.has-hover ? #343b45 : #272d35;
    border-color: root.primary ? #e6bd65 : #414851;
    border-width: 1px;
    opacity: root.active ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if root.active { root.triggered(); } }
    Text { text: root.label; color: !root.active ? #a4adb9 : root.primary ? #191d22 : #d8dce3; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    pointer := TouchArea { enabled: root.active; mouse-cursor: MouseCursor.pointer; clicked => { root.triggered(); } }
}

component Adjustment inherits VerticalLayout {
    in property <string> label;
    in property <bool> active;
    in property <float> minimum: -100;
    in property <float> maximum: 100;
    in-out property <float> value;
    callback adjusted(float);
    spacing: 5px;
    HorizontalLayout {
        Text { text: root.label; color: #cbd1d9; font-size: 12px; }
        Text { text: "" + round(root.value * 100) / 100; color: #d9bd81; font-size: 12px; horizontal-alignment: right; }
    }
    Slider { minimum: root.minimum; maximum: root.maximum; value <=> root.value; enabled: root.active; changed(v) => { root.adjusted(v); } }
}

export component AppWindow inherits Window {
    title: "Z30 Studio · 原生开发预览";
    preferred-width: 1320px; preferred-height: 860px;
    min-width: 1000px; min-height: 680px;
    background: #161a20;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    in property <[PhotoView]> photos;
    in property <int> selected-index: -1;
    in property <image> preview;
    in property <image> original-preview;
    in property <string> preview-fingerprint;
    in property <string> neutral-fingerprint;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <bool> export-busy: false;
    in property <bool> export-cancellable: false;
    in property <string> export-status: "";
    in property <string> batch-status: "";
    in property <string> batch-report: "";
    in property <bool> batch-running: false;
    in property <bool> batch-paused: true;
    in property <bool> batch-has-queued: false;
    in property <bool> batch-has-retry: false;
    in property <bool> batch-has-records: false;
    in property <bool> batch-protected: false;
    in-out property <bool> batch-settings-visible: false;
    in-out property <bool> batch-report-visible: false;
    in-out property <int> batch-mode: 0;
    in-out property <int> export-format: 0;
    in property <bool> has-preview: false;
    in property <bool> busy: false;
    in property <bool> can-import: true;
    in property <bool> engine-ready: false;
    in property <bool> ai-ready: false;
    in property <bool> ai-busy: false;
    in property <string> ai-status: "";
    in property <string> ai-report: "";
    in-out property <bool> ai-report-visible: false;
    in property <bool> ai-suggestion-ready: false;
    in-out property <bool> ai-settings-visible: false;
    in-out property <int> ai-style: 0;
    in-out property <int> ai-provider: 0;
    in-out property <string> ai-api-base: "";
    in-out property <string> ai-model: "";
    in-out property <string> ai-api-key: "";
    in-out property <int> ai-mode: 0;
    in-out property <float> ai-strength: 100;
    in-out property <string> ai-goal: "";
    in property <string> photo-name: "欢迎来到你的暗房";
    in property <string> photo-info: "从本机导入照片开始";
    in property <string> colour-info: "";
    in property <string> status: "就绪 · 本机原生窗口";
    in property <string> draft-status: "原片仅引用，不会被覆盖";
    in-out property <bool> compare: false;
    in-out property <bool> about-visible: false;
    in-out property <bool> exit-warning: false;
    in-out property <float> zoom: 1;
    in-out property <float> exposure: 0;
    in-out property <float> contrast: 0;
    in-out property <float> highlights: 0;
    in-out property <float> shadows: 0;
    in-out property <float> temperature: 0;
    in-out property <float> tint: 0;
    in-out property <float> saturation: 0;
    in-out property <float> vibrance: 0;
    in-out property <float> sharpen: 0;
    callback import-files();
    callback select-photo(int);
    callback rate-photo(int);
    callback cancel-preview();
    callback adjust(string, float);
    callback reset-edits();
    callback undo-edit();
    callback redo-edit();
    callback retry-preview();
    callback cancel-export();
    callback export-photo();
    callback batch-export();
    callback batch-pause-resume();
    callback batch-cancel();
    callback batch-retry();
    callback batch-clear();
    callback auto-grade();
    callback cancel-ai();
    callback apply-ai-suggestion();
    callback dismiss-ai-suggestion();
    callback confirm-exit();

    VerticalLayout {
        spacing: 1px; padding: 0px;
        Rectangle {
            height: 70px; background: #20252d;
            HorizontalLayout {
                padding-left: 22px; padding-right: 22px; padding-top: 16px; padding-bottom: 16px; spacing: 12px;
                VerticalLayout {
                    alignment: center; spacing: 2px;
                    Text { text: "Z30  STUDIO"; color: #f0d39b; font-size: 23px; font-weight: 700; }
                    Text { text: "你的摄影暗房"; color: #969faa; font-size: 10px; }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                ToolButton { label: "＋ 导入照片"; min-width: 108px; active: root.can-import; triggered => { root.import-files(); } }
                ToolButton { label: "一键 AI 调色"; min-width: 105px; active: root.ai-ready && root.has-preview && !root.busy && !root.ai-busy && !root.batch-running; triggered => { root.auto-grade(); } }
                ToolButton { label: "AI 设置"; min-width: 68px; triggered => { root.ai-settings-visible = true; } }
                ComboBox { width: 145px; height: 34px; model: ["JPEG · 95", "PNG · 8 位", "TIFF · 16 位"]; current-index <=> root.export-format; enabled: !root.export-busy; }
                ToolButton { label: "导出照片"; primary: true; active: root.engine-ready && root.has-preview && !root.busy && !root.export-busy && !root.batch-running; triggered => { root.export-photo(); } }
                ToolButton { label: "批量导出"; min-width: 84px; active: root.photos.length > 0 && !root.batch-protected && !root.batch-running && !root.export-busy && !root.ai-busy; triggered => { root.batch-settings-visible = true; } }
                ToolButton { label: "关于"; min-width: 54px; triggered => { root.about-visible = true; } }
            }
        }
        HorizontalLayout {
            spacing: 1px;
            Rectangle {
                width: 228px; background: #1d2229;
                VerticalLayout {
                    padding: 16px; spacing: 14px;
                    HorizontalLayout {
                        Text { text: "照片库"; color: #e6e9ee; font-size: 15px; font-weight: 600; }
                        Text { text: "" + root.photos.length; color: #d7b773; horizontal-alignment: right; }
                    }
                    Text { text: "NEF  /  JPEG  /  PNG"; color: #7f8996; font-size: 10px; }
                    ListView {
                        for photo[index] in root.photos: Rectangle {
                            height: 92px;
                            background: root.selected-index == index ? #303137 : #242a32;
                            border-radius: 5px;
                            border-width: root.selected-index == index ? 1px : 0px;
                            border-color: #c6a35d;
                            HorizontalLayout {
                                padding: 8px; spacing: 8px;
                                Rectangle {
                                    width: 54px; background: #161a20; border-radius: 3px;
                                    Image { source: photo.thumbnail; image-fit: contain; }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 5px;
                                    Text { text: photo.name; color: #d8dde4; font-size: 11px; overflow: elide; }
                                    Text { text: photo.detail; color: #7f8996; font-size: 9px; overflow: elide; }
                                    Text { text: photo.stars; color: #d7b773; font-size: 11px; }
                                }
                            }
                            TouchArea { clicked => { root.select-photo(index); } }
                            accessible-role: list-item;
                            accessible-label: photo.name;
                        }
                    }
                    Text { text: root.draft-status; color: #929da9; font-size: 10px; wrap: word-wrap; }
                    Text { text: "本机浮点显影 · 原片只读\n逐张保存参数 · 全尺寸 sRGB 导出"; color: #7b8796; font-size: 10px; wrap: word-wrap; }
                }
            }
            Rectangle {
                horizontal-stretch: 1; background: #12161b;
                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    HorizontalLayout {
                        Text { text: root.photo-name; color: #d8dee7; font-size: 12px; overflow: elide; }
                        ToolButton { label: root.compare ? "显示调整后" : "查看调整前"; active: root.has-preview; triggered => { root.compare = !root.compare; } }
                        ToolButton { label: root.zoom == 1 ? "放大" : "适合窗口"; active: root.has-preview; triggered => { root.zoom = root.zoom == 1 ? 1.5 : 1; } }
                    }
                    Rectangle {
                        vertical-stretch: 1; background: #101318; clip: true;
                        if root.has-preview: Image {
                            source: root.compare ? root.original-preview : root.preview; image-fit: contain;
                            width: parent.width * root.zoom; height: parent.height * root.zoom;
                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        }
                        if !root.has-preview: VerticalLayout {
                            alignment: center; padding: 50px; spacing: 14px;
                            Text { text: "光影，从这里开始"; color: #e7cf9f; font-size: 25px; horizontal-alignment: center; }
                            Text { text: "导入照片，在本机调整光线与色彩。\n导出为新文件，原片保持不变。"; color: #8e99a6; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                            ToolButton { label: "选择照片"; primary: true; active: root.can-import; triggered => { root.import-files(); } }
                        }
                        if root.busy: Rectangle {
                            x: 12px; y: 12px; width: 140px; height: 33px;
                            border-radius: 5px; background: #292d34;
                            Text { text: "正在更新预览…"; color: #e6c783; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    Text { text: root.photo-info; color: #a2adba; font-size: 11px; overflow: elide; }
                    Text { text: root.colour-info; color: #818b97; font-size: 10px; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: start; spacing: 8px;
                        Text { text: "评分"; color: #929da9; vertical-alignment: center; }
                        for rating in 6: ToolButton { label: rating == 0 ? "清除" : "" + rating + " ★"; min-width: 42px; active: root.selected-index >= 0; triggered => { root.rate-photo(rating); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        ToolButton { label: root.busy ? "取消预览" : "重新预览"; active: root.selected-index >= 0; triggered => { if root.busy { root.cancel-preview(); } else { root.retry-preview(); } } }
                    }
                }
            }
            Rectangle {
                width: 300px; background: #1d2229;
                VerticalLayout {
                    padding: 18px; spacing: 14px;
                    HorizontalLayout {
                        Text { text: "显影调整"; color: #e0e5ed; font-size: 15px; font-weight: 600; }
                        ToolButton { label: "重置"; min-width: 50px; active: root.engine-ready; triggered => { root.reset-edits(); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ToolButton { label: "撤销"; active: root.can-undo; triggered => { root.undo-edit(); } }
                        ToolButton { label: "重做"; active: root.can-redo; triggered => { root.redo-edit(); } }
                    }
                    Text { text: root.engine-ready ? "浮点显影 · 参数自动保存\n连续调整约半秒后记为一步撤销" : "选择照片并等待预览后即可调整"; color: #b19c76; font-size: 11px; wrap: word-wrap; }
                    ScrollView {
                        VerticalLayout {
                            spacing: 12px; padding-right: 6px;
                            Text { text: "光线"; color: #e7d0a4; font-size: 12px; }
                            Adjustment { label: "曝光 EV"; minimum: -4; maximum: 4; value <=> root.exposure; active: root.engine-ready; adjusted(v) => { root.adjust("exposure", v); } }
                            Adjustment { label: "对比度"; value <=> root.contrast; active: root.engine-ready; adjusted(v) => { root.adjust("contrast", v); } }
                            Adjustment { label: "高光"; value <=> root.highlights; active: root.engine-ready; adjusted(v) => { root.adjust("highlights", v); } }
                            Adjustment { label: "阴影"; value <=> root.shadows; active: root.engine-ready; adjusted(v) => { root.adjust("shadows", v); } }
                            Text { text: "色彩"; color: #e7d0a4; font-size: 12px; }
                            Adjustment { label: "色温"; value <=> root.temperature; active: root.engine-ready; adjusted(v) => { root.adjust("temperature", v); } }
                            Adjustment { label: "色调"; value <=> root.tint; active: root.engine-ready; adjusted(v) => { root.adjust("tint", v); } }
                            Adjustment { label: "饱和度"; value <=> root.saturation; active: root.engine-ready; adjusted(v) => { root.adjust("saturation", v); } }
                            Adjustment { label: "自然饱和度"; value <=> root.vibrance; active: root.engine-ready; adjusted(v) => { root.adjust("vibrance", v); } }
                            Text { text: "细节"; color: #e7d0a4; font-size: 12px; }
                            Adjustment { label: "锐化"; minimum: 0; value <=> root.sharpen; active: root.engine-ready; adjusted(v) => { root.adjust("sharpen", v); } }
                        }
                    }
                }
            }
        }
        if root.ai-status != "": HorizontalLayout {
            height: 42px; padding-left: 18px; padding-right: 18px; spacing: 9px;
            Text { text: root.ai-status; color: #e5c58e; font-size: 11px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
            ToolButton { label: "查看分析"; width: 76px; active: root.ai-report != "" && !root.ai-busy; triggered => { root.ai-report-visible = true; } }
            ToolButton { label: "取消 AI"; width: 76px; active: root.ai-busy; triggered => { root.cancel-ai(); } }
            ToolButton { label: "应用建议"; width: 88px; primary: true; active: root.ai-suggestion-ready && !root.ai-busy; triggered => { root.apply-ai-suggestion(); } }
            ToolButton { label: "关闭"; width: 56px; active: !root.ai-busy; triggered => { root.dismiss-ai-suggestion(); } }
        }
        if root.export-status != "": HorizontalLayout {
            height: 40px; padding-left: 18px; padding-right: 18px; spacing: 8px;
            Text { text: root.export-status; color: #d8bd86; font-size: 11px; overflow: elide; vertical-alignment: center; }
            ToolButton { label: "取消导出"; width: 90px; active: root.export-cancellable; triggered => { root.cancel-export(); } }
        }
        if root.batch-status != "": HorizontalLayout {
            height: 42px; padding-left: 18px; padding-right: 18px; spacing: 8px;
            Text { text: root.batch-status; color: #d6c294; font-size: 11px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
            ToolButton { label: root.batch-paused ? "继续队列" : "暂停队列"; width: 80px; active: !root.batch-protected && root.batch-has-queued; triggered => { root.batch-pause-resume(); } }
            ToolButton { label: "取消批量"; width: 80px; active: !root.batch-protected && (root.batch-has-queued || root.batch-running); triggered => { root.batch-cancel(); } }
            ToolButton { label: "重试失败"; width: 80px; active: !root.batch-protected && root.batch-has-retry && !root.batch-running; triggered => { root.batch-retry(); } }
            ToolButton { label: "明细"; width: 55px; active: root.batch-has-records; triggered => { root.batch-report-visible = true; } }
        }
        Rectangle {
            height: 34px; background: #20252d;
            HorizontalLayout {
                padding-left: 18px; padding-right: 18px;
                Text { text: root.status; color: #aab4c1; font-size: 10px; vertical-alignment: center; overflow: elide; }
                Text { text: "NATIVE  /  0.1 开发版"; color: #d8bd86; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
            }
        }
    }
    if root.ai-report-visible: Rectangle {
        background: #101318ec;
        Rectangle {
            width: 620px; height: 450px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 10px; border-width: 1px; border-color: #675e4b; background: #222831;
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Text { text: "AI 画面分析"; color: #f0d39b; font-size: 22px; font-weight: 700; }
                ScrollView { Text { text: root.ai-report; color: #d4dde6; font-size: 13px; wrap: word-wrap; } }
                ToolButton { label: "返回暗房"; triggered => { root.ai-report-visible = false; } }
            }
        }
    }
    if root.batch-settings-visible: Rectangle {
        background: #101318ec;
        Rectangle {
            width: 560px; height: 360px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 10px; border-width: 1px; border-color: #675e4b; background: #222831;
            VerticalLayout {
                padding: 24px; spacing: 15px;
                Text { text: "批量导出全部照片"; color: #f0d39b; font-size: 22px; font-weight: 700; }
                Text { text: "每张照片全尺寸导出到新目录，任务会先保存到本机。重启后保持暂停，需要手动继续。已有文件和原片不会覆盖。"; color: #bec8d2; font-size: 12px; wrap: word-wrap; }
                Text { text: "调色配方"; color: #d1d9e1; }
                ComboBox { model: ["每张照片各自的参数", "所有照片使用当前照片参数"]; current-index <=> root.batch-mode; }
                Text { text: "输出格式沿用顶部的 JPEG / PNG / TIFF16 选择。暂停会在当前照片完成后生效；取消会停止当前编码并取消未开始任务。"; color: #9ba9b7; font-size: 11px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    ToolButton { label: "返回"; triggered => { root.batch-settings-visible = false; } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ToolButton { label: "选择输出目录并开始"; min-width: 170px; primary: true; triggered => { root.batch-settings-visible = false; root.batch-export(); } }
                }
            }
        }
    }
    if root.batch-report-visible: Rectangle {
        background: #101318ec;
        Rectangle {
            width: 720px; height: min(590px, parent.height - 30px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 10px; border-width: 1px; border-color: #675e4b; background: #222831;
            VerticalLayout {
                padding: 22px; spacing: 12px;
                Text { text: "批量任务明细"; color: #f0d39b; font-size: 22px; font-weight: 700; }
                ScrollView { vertical-stretch: 1; Text { text: root.batch-report; color: #d4dde6; font-size: 12px; wrap: word-wrap; } }
                HorizontalLayout {
                    ToolButton { label: "清理已结束记录"; min-width: 122px; active: !root.batch-protected; triggered => { root.batch-clear(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ToolButton { label: "返回暗房"; triggered => { root.batch-report-visible = false; } }
                }
            }
        }
    }
    if root.ai-settings-visible: Rectangle {
        background: #101318ec;
        Rectangle {
            width: 620px; height: min(680px, parent.height - 20px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 10px; border-width: 1px; border-color: #675e4b; background: #222831;
            VerticalLayout {
                padding: 22px; spacing: 10px;
                Text { text: "AI 调色设置"; color: #f0d39b; font-size: 22px; font-weight: 700; }
                ScrollView { vertical-stretch: 1;
                  VerticalLayout { spacing: 10px;
                    Text { text: "选择服务后才会发送两张最长边 1024 像素的 sRGB JPEG 预览和当前九参数、调色目标；程序不自动附带原片、文件名、路径、EXIF 或 GPS。请勿在目标中写入不想发送的信息。输出均经过相同的参数和画质检查。"; color: #bec8d2; font-size: 12px; wrap: word-wrap; }
                    Text { text: "模型来源"; color: #d1d9e1; }
                    ComboBox { model: ["Codex CLI（使用现有登录）", "DeepSeek Flash（图像）", "OpenAI 兼容图像接口"]; current-index <=> root.ai-provider; enabled: !root.ai-busy; }
                    if root.ai-provider == 2: VerticalLayout { spacing: 8px;
                        Text { text: "Base URL（例如 https://服务商/v1；本机可用 http://127.0.0.1:端口/v1）"; color: #d1d9e1; font-size: 11px; }
                        LineEdit { text <=> root.ai-api-base; placeholder-text: "https://example.com/v1"; enabled: !root.ai-busy; }
                        Text { text: "支持图片输入的模型名"; color: #d1d9e1; }
                        LineEdit { text <=> root.ai-model; placeholder-text: "模型 ID"; enabled: !root.ai-busy; }
                    }
                    if root.ai-provider != 0: VerticalLayout { spacing: 7px;
                        Text { text: root.ai-provider == 1 ? "API Key（仅本次请求驻留内存；也可设 DEEPSEEK_API_KEY 环境变量）" : "API Key（仅本次请求驻留内存；也可设 Z30_AI_API_KEY 环境变量）"; color: #d1d9e1; font-size: 11px; wrap: word-wrap; }
                        LineEdit { text <=> root.ai-api-key; input-type: password; placeholder-text: root.ai-provider == 1 ? "sk-…" : "API Key；本机回环接口可留空"; enabled: !root.ai-busy; }
                    }
                Text { text: "风格"; color: #d1d9e1; }
                ComboBox { model: ["自然", "人像", "胶片", "产品静物", "夜景"]; current-index <=> root.ai-style; enabled: !root.ai-busy; }
                Text { text: "补充目标（仅作数据传给模型，最多 350 字）"; color: #d1d9e1; }
                LineEdit { text <=> root.ai-goal; placeholder-text: "例如：保留傍晚暖光，肤色自然"; enabled: !root.ai-busy; }
                Text { text: "调色强度  " + round(root.ai-strength) + "%"; color: #d1d9e1; }
                Slider { minimum: 0; maximum: 100; value <=> root.ai-strength; enabled: !root.ai-busy; }
                Text { text: "处理方式"; color: #d1d9e1; }
                ComboBox { model: ["自动应用（可撤销）", "只给建议（手动应用）"]; current-index <=> root.ai-mode; enabled: !root.ai-busy; }
                Text { text: root.ai-provider == 0 ? "Codex CLI 需先运行 codex login。" : "兼容接口需支持图像输入与 JSON 对象响应；远端必须为 HTTPS，可能由服务商计费。Key 不写入项目或命令行。"; color: #9ba9b7; font-size: 11px; wrap: word-wrap; }
                Text { text: "AI 仅能调整九个全局参数；不会修复污点、局部蒙版或增加丢失的 RAW 细节。不会自动重试或重复调用。"; color: #9ba9b7; font-size: 11px; wrap: word-wrap; }
                  }
                }
                HorizontalLayout {
                    spacing: 12px;
                    ToolButton { label: "返回暗房"; triggered => { root.ai-settings-visible = false; } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ToolButton { label: "开始调色"; primary: true; active: root.ai-ready && root.has-preview && !root.busy && !root.ai-busy; triggered => { root.ai-settings-visible = false; root.auto-grade(); } }
                }
            }
        }
    }
    if root.about-visible: Rectangle {
        background: #101318e8;
        VerticalLayout {
            alignment: center; padding: 80px; spacing: 18px;
            Text { text: "Z30 Studio · 原生开发版"; color: #ead4ab; font-size: 24px; horizontal-alignment: center; }
            Text { text: "Rust + Slint  /  本机照片工具\n阶段能力与未验证项见随附文档。"; color: #b3becb; horizontal-alignment: center; }
            AboutSlint { }
            ToolButton { label: "返回暗房"; triggered => { root.about-visible = false; } }
        }
    }
    if root.exit-warning: Rectangle {
        background: #101318ee;
        VerticalLayout {
            alignment: center; padding: 90px; spacing: 20px;
            Text { text: "有尚未成功保存的改动"; color: #f0d39b; font-size: 24px; horizontal-alignment: center; }
            Text { text: "原片保持不变。返回后可以检查保存错误，或明确放弃未保存的参数、评分与选择。"; color: #c0c8d3; wrap: word-wrap; horizontal-alignment: center; }
            ToolButton { label: "返回检查"; primary: true; triggered => { root.exit-warning = false; } }
            ToolButton { label: "放弃未保存改动并退出"; triggered => { root.confirm-exit(); } }
        }
    }
}
